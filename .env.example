# ─────────────────────────────────────────────────────────────
# CrowdVision Platform - Unified Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env or configure in the Render Dashboard (Environment tab)

# ──── Backend API Configuration ────
APP_NAME=CrowdVision Platform API
APP_ENV=production
APP_HOST=0.0.0.0
# PORT is dynamically assigned by Render (e.g. 10000); leave default for local testing
PORT=8000
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# CORS: comma-separated list of allowed origins (Render domains *.onrender.com are auto-matched)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./crowdvision_main.db
# Render Managed PostgreSQL (auto-normalized to asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@host.oregon-postgres.render.com/crowdvision_db
DATA_RETENTION_DAYS=30

# Persistent Disk Storage (Render Disk Mount Path, e.g. /data)
# DATA_DIR=/data
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
MAX_VIDEO_DIMENSION=4096
SAMPLE_FPS=2.0
INFERENCE_WIDTH=640
INFERENCE_CONFIDENCE=0.35
YOLO_MODEL_PATH=models/yolov8n.onnx

# ──── Independent AI Agent Subsystem (:8001) ────
AI_AGENT_BASE_URL=http://localhost:8001
AI_AGENT_URL=http://localhost:8001
AI_AGENT_API_KEY=replace_with_shared_agent_api_key
AI_AGENT_TIMEOUT_SECONDS=5.0
AI_AGENT_ENABLED=true

# Optional LLM Integration (for conversational operator reasoning & Copilot)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ──── Frontend (Only required if deploying Frontend as a separate Render Static Site) ────
# VITE_API_BASE_URL=https://crowdvision-backend.onrender.com
# VITE_WS_BASE_URL=wss://crowdvision-backend.onrender.com
