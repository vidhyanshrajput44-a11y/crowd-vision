# CrowdVision Main Backend - Environment Configuration Template
# Copy this file to .env and configure for your environment.

APP_NAME=CrowdVision Platform API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Security & Authentication
# In production, generate a secure random key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite default for local development; use postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./crowdvision_main.db
DATA_RETENTION_DAYS=30

# Video Ingestion & Processing Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
MAX_VIDEO_DIMENSION=4096
SAMPLE_FPS=2.0
INFERENCE_WIDTH=640
INFERENCE_CONFIDENCE=0.35
YOLO_MODEL_PATH=models/yolov8n.onnx

# Prediction Engine
FORECAST_HORIZONS_SECONDS=60,180,300
MIN_HISTORY_FOR_PREDICTION=5

# Autonomous AI Crowd Analyst Agent Subsystem
AI_AGENT_BASE_URL=http://localhost:8100
AI_AGENT_API_KEY=replace_with_shared_agent_api_key
AI_AGENT_TIMEOUT_SECONDS=5.0
AI_AGENT_ENABLED=true
