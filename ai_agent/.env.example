# CrowdVision AI Agent - Environment Configuration
# Copy to .env and fill in values

# ──── Application ────
APP_NAME=crowdvision-ai-agent
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8100
APP_WORKERS=1
APP_LOG_LEVEL=INFO

# ──── API Authentication ────
API_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
API_TOKEN_EXPIRE_MINUTES=60
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ──── PostgreSQL ────
DATABASE_URL=postgresql+asyncpg://crowdvision:crowdvision@localhost:5432/crowdvision_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ──── Redis ────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true

# ──── LLM Provider ────
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_ENABLED=true

# ──── Agent Processing ────
AGENT_ANALYSIS_INTERVAL=5.0
AGENT_MAX_QUEUE_SIZE=1000
AGENT_BATCH_SIZE=20
AGENT_DEDUP_WINDOW=2.0
AGENT_LLM_COOLDOWN=10.0
AGENT_HISTORY_WINDOW_MINUTES=30
AGENT_MAX_CONTEXT_ITEMS=100

# ──── Alert Configuration ────
ALERT_DEDUP_WINDOW=60
ALERT_ESCALATION_TIMEOUT=300
ALERT_MAX_ACTIVE=500
ALERT_RETENTION_HOURS=168

# ──── Performance ────
PERF_REQUEST_TIMEOUT=10.0
PERF_WS_HEARTBEAT=30
PERF_CIRCUIT_BREAKER_THRESHOLD=5
PERF_CIRCUIT_BREAKER_TIMEOUT=60
